# Copy to .env and fill in. .env is gitignored; this file is committed
# so anyone cloning the repo knows which variables are required.

# --- Database ---
# Host port is 5433 (see docker-compose.yml) to avoid colliding with a
# native Postgres install on 5432.
DATABASE_URL=postgresql+psycopg://liftsync:devpassword@localhost:5433/liftsync

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Coach ---
# "gemini" for the real model, "fake" for the scripted test double.
LLM_PROVIDER=gemini

# Free key from https://aistudio.google.com — no credit card needed.
GEMINI_API_KEY=

AI_MODEL=gemini-3-flash-preview

# Ceiling on tool calls per request, so a looping model cannot run up
# tokens or hang the request.
AI_MAX_TOOL_CALLS=8

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
